# ==============================================================================
# BLUEBERRY FARM AND RESORT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Meta
APP_NAME="Blueberry Farm and Resort"
APP_ENV=production
APP_TIMEZONE=Asia/Kolkata
HOST=0.0.0.0
PORT=8000

# Centralized MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=blueberry_resort
MYSQL_USER=blueberry_app
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600

# Security and JWT Authentication
JWT_SECRET_KEY=change_this_to_a_random_32_character_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true

# Storage Directories
STORAGE_DIR=storage
LOGS_DIR=logs
ATTACHMENTS_DIR=storage/attachments
BACKUPS_DIR=storage/backups

# CORS Origins (comma-separated)
CORS_ORIGINS=https://blueberryfarmandresort.com,http://localhost:5173

# Automatic Backup Configuration
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
