# ==============================================================================
# BLUEBERRY FARM & RESORT - PRODUCTION .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets (NEVER commit these!)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
storage/.jwt_secret
*.pem
*.key

# Runtime Data, Locks & Legacy JSON Backups
data/*.json
data/*.bak
data/*.lock
!data/.gitkeep

# Logs
logs/*.jsonl
logs/*.log
*.log
!logs/.gitkeep

# Generated PDFs, Uploads & SQL Backups (keep folder structure via .gitkeep)
storage/invoices/*
!storage/invoices/.gitkeep
storage/quotations/*
!storage/quotations/.gitkeep
storage/receipts/*
!storage/receipts/.gitkeep
storage/attachments/*
!storage/attachments/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
*.sql

# Temporary / Scratch Extraction Files
extracted_assets/

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
